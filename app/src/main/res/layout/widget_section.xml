<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_section" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingTop="12dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/widget_section_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="17sp" android:textColor="#24667A"/>
    <TextView android:id="@+id/widget_section_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#66757B"/>
</LinearLayout>
