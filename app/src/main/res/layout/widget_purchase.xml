<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_purchase_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingHorizontal="4dp" android:paddingVertical="2dp">
    <FrameLayout android:id="@+id/widget_purchase_card" android:layout_width="match_parent" android:layout_height="wrap_content"
        >
        <ImageView android:id="@+id/widget_purchase_background" android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" android:src="@drawable/widget_row_background" android:scaleType="fitXY"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingVertical="6dp" android:paddingEnd="10dp">
            <ImageView android:id="@+id/widget_check" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="12dp" android:src="@drawable/widget_unchecked"/>
            <LinearLayout android:id="@+id/widget_item_text" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:orientation="vertical">
                <TextView android:id="@+id/widget_item_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textColor="#26353B"/>
                <TextView android:id="@+id/widget_item_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#66757B"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
